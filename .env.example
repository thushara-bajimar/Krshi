# PostgreSQL connection. `npm run db:start` provides a local server on port 5433 with these credentials.
DATABASE_URL="postgresql://krishi:krishi@localhost:5433/krishi?schema=public"

# Used by integration tests only (a separate database that tests may wipe).
TEST_DATABASE_URL="postgresql://krishi:krishi@localhost:5433/krishi_test?schema=public"

# Public base URL of the app (used for absolute links in reports).
APP_URL="http://localhost:3000"

# Optional: data.gov.in API key for live AGMARKNET mandi prices.
# Get a free key at https://data.gov.in (sign in -> My Account -> API key). Without it, the market module uses clearly labelled SAMPLE data.
DATA_GOV_IN_API_KEY=""

# Optional: Anthropic API key for the AI assistant. Without it, the assistant uses the built-in rule-based parser.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Directory for uploaded files (photos, receipts, soil reports). Must be outside /public.
UPLOAD_DIR="./uploads"
